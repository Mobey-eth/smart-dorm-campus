PORT=3015
HOST=127.0.0.1
DB_PATH=./data/smartdorm.sqlite
# Exact allowed origins for clients connecting directly. Netlify uses /api proxy.
ALLOWED_ORIGINS=https://api-ipes.chimaobi.xyz
# Set only behind the single trusted reverse proxy in compose.yaml.
TRUST_PROXY=0
# Required only for the protected presentation reset. Never put this in dist/.
DEMO_RESET_PIN=
